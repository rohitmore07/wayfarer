# ---------------------------------------------------------------------------
# Wayfarer AI — environment
# Copy to `.env.local`. Everything below is optional: the app runs fully with
# clearly-labelled demo adapters when no keys are present.
# ---------------------------------------------------------------------------

# AI (either provider; both are optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Flights — Amadeus Self-Service (test host by default)
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_HOST=https://test.api.amadeus.com

# Maps (optional — the app ships an offline vector map)
GOOGLE_MAPS_API_KEY=

# Weather: Open-Meteo needs no key and is enabled by default.
